PORT=8000
INTERNAL_TOKEN_SECRET=dev-only-internal-secret-change-me
ORDERS_SERVICE_URL=http://orders:8000
INVENTORY_SERVICE_URL=http://inventory:8000
CATALOG_SERVICE_URL=http://catalog:8000
TELEMETRY_SERVICE_URL=http://telemetry:8000
SECURITY_SERVICE_URL=http://security:8000
CHAT_SERVICE_URL=http://chat:8000
AI_DB_URL=postgresql+asyncpg://ai:ai@ai-db:5432/ai
# Gemini embeddings via Vertex AI (STR-161b): IAM/Workload Identity, no API
# key. Must match ai-assistant's GCP_PROJECT / model / dimensions exactly —
# both read and write the same pgvector index in AI_DB_URL.
GCP_PROJECT=your-gcp-project
GCP_LOCATION=global
EMBEDDING_MODEL=gemini-embedding-001
EMBEDDING_DIMENSIONS=1536
