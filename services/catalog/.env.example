PORT=8000
DATABASE_URL=postgresql+asyncpg://catalog:catalog@localhost:5433/catalog
# Object storage: private GCS bucket over its S3-compatible XML API + HMAC key.
# catalog and chat share one bucket, isolated by OBJECT_STORAGE_KEY_PREFIX.
OBJECT_STORAGE_ENDPOINT=https://storage.googleapis.com
OBJECT_STORAGE_PUBLIC_BASE_URL=https://storage.googleapis.com
OBJECT_STORAGE_ACCESS_KEY=
OBJECT_STORAGE_SECRET_KEY=
OBJECT_STORAGE_BUCKET=
OBJECT_STORAGE_KEY_PREFIX=catalog/
