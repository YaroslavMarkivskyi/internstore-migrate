# Own instance — see README's "physical instance separation" note. Never
# points at telemetry-db.
DATABASE_URL=postgresql+asyncpg://telemetry-aggregates:telemetry-aggregates@localhost:5437/telemetry-aggregates

# Read-only connection to telemetry-db, used only by backfill.py — the one
# deliberate exception to this service's no-cross-database-dependency
# preference. See README's "Backfill job" section.
TELEMETRY_DB_URL=postgresql+asyncpg://telemetry:telemetry@localhost:5436/telemetry

KAFKA_BOOTSTRAP_SERVERS=localhost:29092
BACKFILL_INTERVAL_MINUTES=15
