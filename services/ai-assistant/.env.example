PORT=8000
DATABASE_URL=postgresql+asyncpg://ai:ai@localhost:5437/ai
INTERNAL_TOKEN_SECRET=dev-only-internal-secret-change-me
KAFKA_BOOTSTRAP_SERVERS=localhost:29092
REDIS_URL=redis://localhost:6379
CHAT_SERVICE_URL=http://localhost:8000
ORDERS_SERVICE_URL=http://localhost:8000
MCP_GATEWAY_URL=http://localhost:8000
AUTH_BACKEND_URL=http://localhost:3001
# Gemini via Vertex AI / the Gemini Enterprise Agent Platform (STR-161b):
# IAM/Workload Identity auth, no API key. Locally, run
# `gcloud auth application-default login` and set GCP_PROJECT to that project.
GCP_PROJECT=your-gcp-project
GCP_LOCATION=global
CHAT_MODEL=gemini-2.5-flash
EMBEDDING_MODEL=gemini-embedding-001
EMBEDDING_DIMENSIONS=1536
AI_MODE_DEFAULT=ai
AI_RATE_LIMIT=10
